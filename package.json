{
  "name": "ts-eval",
  "version": "0.1.0",
  "private": true,
  "description": "A JavaScript interpreter written entirely in the TypeScript type system",
  "type": "module",
  "scripts": {
    "test": "tsc -p .",
    "test:bun": "bun check -p .",
    "test:stats": "tsc -p . --extendedDiagnostics",
    "examples": "tsc -p examples --extendedDiagnostics",
    "examples:bun": "bun check -p examples --timing",
    "test:all": "npm test && npm run test:bun && npm run examples && npm run examples:bun",
    "lint": "node scripts/find-deferred.cjs",
    "bench": "node bench/checkers.cjs",
    "bench:micro": "node bench/micro.cjs"
  },
  "devDependencies": {
    "bun": "1.4.2-canary.20261007.1",
    "ts5": "npm:typescript@^5.9.3",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "bun@1.4.2-canary.20261007.1": true
  }
}
